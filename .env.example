# FixProof Environment Configuration Example
# Copy this file to .env and configure values for your environment.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixproof_db

# Supabase (Optional for auth/storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Object Storage: "local" (default for dev) or "supabase" or "s3"
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PATH=./storage
OBJECT_STORAGE_BUCKET_PRIVATE=private-evidence
OBJECT_STORAGE_BUCKET_PUBLIC_APPROVED=public-evidence

# Background Jobs / Redis (optional for pilot, default uses persistent DB jobs)
REDIS_URL=

# Maps
MAP_PROVIDER=osm
MAP_PROVIDER_API_KEY=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_public_key_here

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Worker Configuration & Roboflow 5-Model Suite
AI_WORKER_ENABLED=false
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_GARBAGE=garbage_detection-wvzwv-n8vsv/1
ROBOFLOW_MODEL_ROAD=road-damage-detection-fn0qh/1
ROBOFLOW_MODEL_WATERLOGGING=water-logging-a7zhi/1
ROBOFLOW_MODEL_CIVIC_1=civic-issues-lroee/3
ROBOFLOW_MODEL_CIVIC_2=civic-issues-nq7sy-bh8t3/1
NOMINATIM_USER_AGENT=GramaSeva-Belagavi-Pilot/1.0
ROAD_MODEL_PATH=
ROAD_MODEL_REVISION=
LEAK_MODEL_PATH=
LEAK_MODEL_REVISION=
LITTER_MODEL_PATH=
LITTER_MODEL_REVISION=
TRANSLATION_MODEL_PATH=
TRANSLATION_MODEL_REVISION=

# Notification Adapters
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false
